---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", (entry) => postFilter(entry));
// Most-used tags first, then alphabetical — a small "popular first" touch.
const tags = getUniqueTags(posts).sort(
  (a, b) => b.count - a.count || a.tagName.localeCompare(b.tagName)
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="mt-2 flex flex-wrap gap-2.5">
      {tags.map(({ tag, tagName, count }) => <Tag {tag} {tagName} {count} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
