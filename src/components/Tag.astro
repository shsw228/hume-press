---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  count?: number;
  size?: "sm" | "lg";
};

const { tag, tagName, count, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group border-border bg-surface hover:card-shadow hover:border-foreground/20 inline-flex items-center gap-1.5 rounded-full border transition-[box-shadow,transform,border-color] duration-200 hover:-translate-y-0.5 active:scale-95",
      size === "lg" ? "px-3.5 py-1.5 text-sm" : "px-3 py-1 text-xs",
    ]}
  >
    <span class="text-muted-foreground" aria-hidden="true">#</span>
    <span class="text-foreground font-medium">{tagName}</span>
    {
      typeof count === "number" && (
        <span class="text-muted-foreground tabular-nums">{count}</span>
      )
    }
  </a>
</li>
