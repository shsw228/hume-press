---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article>
    <header class="mb-8">
      <div class="text-xs text-[color:var(--fg-muted)]">
        {fmt.format(article.data.pubDate)}
        {article.data.updatedDate && ` · updated ${fmt.format(article.data.updatedDate)}`}
      </div>
      <h1 class="text-2xl font-bold mt-1">{article.data.title}</h1>
      {article.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2 text-xs text-[color:var(--fg-muted)]">
          {article.data.tags.map((t) => <span>#{t}</span>)}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="mt-12 text-sm">
      <a href={base} class="hover:underline">← Back to articles</a>
    </p>
  </article>
</BaseLayout>
