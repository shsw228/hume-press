---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ModelThumb from "@/components/ModelThumb.astro";
import config from "@/config";

const base = import.meta.env.BASE_URL;

const works = [
  {
    href: base + "works/desk-mount/",
    title: "Desk Mac Mini Mount",
    desc: "机裏に Mac Mini を吊る VESA マウント＋変換ブラケット。Blender 設計・CalculiX で構造解析。ブラウザで回せる 3D モデルつき。",
    tag: "3D / FEM",
    model: "models/desk-mount.glb",
  },
];
---

<Layout
  title={`Works | ${config.site.title}`}
  description="制作物・3D モデリング・設計の記録。"
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Works" pageDesc="制作物・3D モデリング・設計の記録。">
    <ul class="mt-4 grid gap-5 sm:grid-cols-2">
      {
        works.map(w => (
          <li>
            <a
              href={w.href}
              class="group border-border bg-surface hover:card-shadow block overflow-hidden rounded-2xl border transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5"
            >
              <div class="bg-muted relative aspect-[16/10] overflow-hidden">
                <ModelThumb src={w.model} ariaLabel={`${w.title} の3Dモデル`} />
              </div>
              <div class="p-5">
                <div class="flex items-center justify-between gap-3">
                  <h2 class="text-foreground text-lg font-semibold tracking-tight">
                    {w.title}
                  </h2>
                  <span class="border-border text-muted-foreground shrink-0 rounded-full border px-2.5 py-0.5 text-xs">
                    {w.tag}
                  </span>
                </div>
                <p class="text-muted-foreground mt-2 text-sm">{w.desc}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
