---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const RECENT_COUNT = 5;

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recent = articles.slice(0, RECENT_COUNT);

const fmt = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="hume.com" description="個人技術ブログ">
  <section>
    <h2 class="text-lg font-bold mb-4">最近の記事</h2>
    <ul class="space-y-4">
      {recent.map((article) => (
        <li>
          <a href={`${base}articles/${article.id}/`} class="block hover:underline">
            <div class="text-xs text-[color:var(--fg-muted)]">{fmt.format(article.data.pubDate)}</div>
            <div class="text-base font-medium">{article.data.title}</div>
            {article.data.description && (
              <div class="text-sm text-[color:var(--fg-muted)] mt-1">{article.data.description}</div>
            )}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm">
      <a href={`${base}articles/`} class="hover:underline">→ 記事一覧 ({articles.length}件)</a>
    </p>
  </section>
</BaseLayout>
